---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** The screenshot. With a `video` it is the poster, and stays if the clip can't play. */
  src: ImageMetadata;
  alt: string;
  /** URL of a silent screen recording, e.g. from `import clip from "…/clip.webm?url"`. */
  video?: string;
}

const { src, alt, video } = Astro.props;
---

<div class="media">
  {video ? (
    <>
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 68rem) 66rem, 100vw"
        loading="lazy"
      />
      <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source src={video} type="video/webm" />
      </video>
    </>
  ) : (
    <a href={src.src} aria-label={`${alt} (full size)`}>
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 68rem) 66rem, 100vw"
        loading="lazy"
      />
    </a>
  )}
</div>

<style>
  .media {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
  }

  a {
    display: block;
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  video.playing {
    opacity: 1;
  }
</style>

<script>
  // Clips load and play only while on screen. With prefers-reduced-motion they never
  // start, and the screenshot stays.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.preload = "auto";
            // Blocked autoplay or an unsupported format: leave the screenshot showing.
            void v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.4 },
    );

    for (const v of document.querySelectorAll<HTMLVideoElement>(".media video")) {
      v.addEventListener("playing", () => v.classList.add("playing"));
      io.observe(v);
    }
  }
</script>
