---
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";

import libraryView from "../../../docs/img/libraryview.png";
import importView from "../../../docs/img/importview2.png";
import projectView from "../../../docs/img/projectview.png";
import skyAtlasView from "../../../docs/img/skyatlasview.png";
import storageView from "../../../docs/img/storageview.png";
import libraryClip from "../../../docs/vid/library.webm?url";
import skyAtlasClip from "../../../docs/vid/skyatlas.webm?url";

const repo = "https://github.com/hawawa4/eirin";
const releases = `${repo}/releases`;
const catalogueViewer = "https://github.com/thebioguy/Astro-Catalogue-Viewer";
const sslm = "https://github.com/AstroNoob-Tools/SSLM";

const title = "Eirin";
const description =
  "A library manager for astrophotography data: catalogue your files on a NAS, preview and cull FITS frames, " +
  "set up Siril projects and map your plate-solved images onto the sky. " +
  "Built around the Seestar S30 Pro and S50 Pro. Free and open source.";

// `video` is a clip from docs/vid/; the screenshot is its poster.
const showcase = [
  {
    title: "Library",
    body: "Every frame under the root folder, grouped by object, date, filter or type, with per-column filters and search. The selected frame's preview and FITS header sit alongside. Select a set of frames to blink through them, reject several at once, or start a project from whatever is filtered. Rejected frames are hidden, not deleted, until you delete them for good. With Siril installed, Analyze measures star FWHM and plate-solves each frame, and Suggest rejects flags frames whose FWHM is well above the rest of their group.",
    image: libraryView,
    video: libraryClip,
    alt: "Library view: filtering by object and opening a processed image in the preview pane",
  },
  {
    title: "Import",
    body: "Shows exactly what will be copied and where before anything happens. Files already in the library are skipped. FITS by default; PNG, JPEG and TIFF can be included too. It can delete from the Seestar after copying, but only once a full SHA-256 of the copy matches the original.",
    image: importView,
    alt: "Import view listing new files from a Seestar and where each one will be copied",
  },
  {
    title: "Projects",
    body: "A project is a local folder laid out the way Siril expects, with each frame type in its own subfolder. Frames are symlinked from the NAS by default, or copied if you prefer. Open the project in Siril with one click, and import its outputs back into the library when you're done.",
    image: projectView,
    alt: "Projects view showing a project's light frames, with buttons to open it in Siril or its folder",
  },
  {
    title: "Sky Atlas",
    body: "Every plate-solved image knows where it was pointing, how much sky it covers and at what angle. The Sky Atlas draws them in their real place on a chart of the sky, with bright stars and Messier and NGC objects for reference. Click an outline to overlay the image. Show only your final images, or every sub as well to see how a mosaic or session covered the field. Search your targets or the built-in catalogue and jump to them. Frames with coordinates in their FITS header appear as soon as they're indexed; the rest can be plate-solved from the Library through Siril. It's not a planetarium and not a replacement for Stellarium: it's for looking back at what you've photographed and seeing where the gaps are.",
    image: skyAtlasView,
    video: skyAtlasClip,
    alt: "Sky Atlas: searching the object list, jumping between targets and overlaying processed images on the sky chart",
  },
  {
    title: "Storage",
    body: "Where your disk space goes: a treemap of every target, sized by how much it takes up. Click into one to see it broken down by night, with totals for lights, stacks, processed images and everything else.",
    image: storageView,
    alt: "Storage view: a treemap of disk usage per target, with totals per frame type",
  },
];

const features = [
  "FITS preview with four stretch levels from linear to strong, debayering of the Seestar's one-shot-colour frames, zoom and pan, and the main header fields at a glance.",
  "A red theme, for using it at the scope without ruining your night vision.",
  "Headless mode: a Docker image for browsing the library from a browser. Read-only, so no import, no projects and no Siril.",
];

const limits = [
  "It's a personal project, built around Seestar data because that's what I have. Other cameras may work but haven't had much testing.",
  "It doesn't stack or process anything itself. Siril is the only processing backend for now, and PixInsight support might come later.",
  "Only Linux builds are published so far. The app builds on Windows and macOS, but there are no packages.",
  "The headless image needs a prefs.db that the desktop app has already set up.",
];
---

<Base title={title} description={description}>
  <header class="hero">
    <div class="wrap">
      <h1>Eirin</h1>
      <p class="sub">
        A library manager for astrophotography data. It keeps your subs, calibration frames and
        finished images in one folder, preferably on a NAS, lets you preview and cull FITS frames,
        and builds the folder structure Siril expects so you can go straight to stacking. Once your
        images are plate-solved, it draws them on a map of the sky.
      </p>
      <p class="sub">
        Built around my own Seestar S30 Pro and S50 Pro, so that's the workflow it fits best.
      </p>
      <p class="cta">
        <a class="btn primary" href={releases}>
          Download
        </a>
        <a class="btn" href={repo}>
          Source
        </a>
      </p>
      <p class="fine">Linux: .deb, AppImage and .zip on the releases page.</p>
    </div>
  </header>

  <main>
    <section>
      <div class="wrap">
        <h2>Human disclaimer</h2>
        <div class="text">
          <p class="muted">
            Eirin is free and open source (MIT). I made it for myself and my own Seestar data. Bug
            reports and suggestions are welcome, but I can't promise anything beyond what I need.
          </p>
          <p class="muted">
            A good part of the code, especially the frontend, was written with AI assistance. I'd
            rather say that up front.
          </p>

          <h3>Why it exists</h3>
          <p class="muted">
            Processing Seestar data on a computer, rather than keeping the scope's live stack, used
            to mean a pile of bash and Python scripts: one to copy each session off the device,
            another to lay it out for Siril. Going through the frames and deleting bad ones was the
            worst part. Siril doesn't make it easy to actually delete a file, ASIFitsView doesn't
            debayer, and clicking through folder after folder gets old quickly. The scripts worked,
            but I wanted something nicer to use. Eirin handles the file management; stacking and
            processing still happen in Siril.
          </p>

          <h3>Contact</h3>
          <p class="muted">
            If you're actually using this and have ideas,{" "}
            <a href={`${repo}/issues/new/choose`}>open an issue on GitHub</a>.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>How it works</h2>
        <ol class="steps text">
          <li>
            <strong>Choose a root folder.</strong> Everything lives here: subs, darks and flats,
            stacks, final images. A NAS share works well. Eirin reads the FITS headers into a local
            SQLite database and leaves the files where they are.
          </li>
          <li>
            <strong>Import from the Seestar.</strong> Point it at the device. Eirin lists the files
            that aren't in your library yet, shows where each one will go, and copies them over.
            <details>
              <summary>Mounting the Seestar on Linux</summary>
              <p>
                The Seestar shares its storage over SMB. Mount it (needs <code>cifs-utils</code>)
                and pick the folder as the import source:
              </p>
              <pre><code
                  >mkdir -p ~/mnt/seestar
sudo mount -t cifs \
  -o guest,uid=$(id -u) \
  "//seestar.local/EMMC Images/" \
  ~/mnt/seestar</code
                ></pre>
              <p>Unmount when you're done:</p>
              <pre><code>sudo umount ~/mnt/seestar</code></pre>
              <p>
                If <code>seestar.local</code> doesn't resolve, use the Seestar's IP address instead.
              </p>
            </details>
          </li>
          <li>
            <strong>Look through and cull.</strong> Preview frames with an autostretch, blink
            through a set, and reject the bad ones.
          </li>
          <li>
            <strong>Create a Siril project.</strong> Pick frames and Eirin creates a local project
            with
            <code>lights/</code>, <code>darks/</code>, <code>flats/</code> and <code>biases/</code>
            folders, symlinked to the originals on the NAS. Open it in Siril and process as usual.
          </li>
          <li>
            <strong>Bring the results back.</strong> Import the stacked and processed images into
            the library. Once they're plate-solved, they show up on the Sky Atlas.
          </li>
        </ol>
      </div>
    </section>

    {showcase.map((f) => (
      <section class="showcase">
        <div class="wrap">
          <h2>{f.title}</h2>
          <p>{f.body}</p>
          <Media src={f.image} alt={f.alt} video={f.video} />
        </div>
      </section>
    ))}

    <section>
      <div class="wrap">
        <h2>Also</h2>
        <ul class="text">
          {features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="install">
      <div class="wrap">
        <h2>Install</h2>
        <div class="text">
          <h3>Linux</h3>
          <p>
            Grab the latest build from the <a href={releases}>releases page</a>. It comes as a
            <code>.deb</code>, an <code>.AppImage</code> and a plain <code>.zip</code>. All three
            need <code>libwebkit2gtk-4.1-0</code>, which the <code>.deb</code> pulls in
            automatically.
          </p>
          <pre><code>sudo apt install ./eirin-linux-amd64.deb</code></pre>
          <p>
            For processing you'll also want <a href="https://siril.org">Siril</a> installed. Eirin
            finds it on your <code>PATH</code>, or you can point it at the binary in Settings.
          </p>

          <h3>Windows and macOS</h3>
          <p>
            No packaged builds yet. The app builds on both, so you can
            <a href={`${repo}#development`}>build it from source</a> in the meantime.
          </p>

          <h3>Headless (Docker)</h3>
          <p>
            The server image needs a <code>prefs.db</code> that the desktop app has already set up,
            since that's where the root folder is configured.
          </p>
          <pre><code
              >docker run -p 8080:8080 \
  -v /path/to/nas:/mnt/nas \
  -v /path/to/prefs.db:/root/.config/eirin/prefs.db \
  ghcr.io/hawawa4/eirin-server:latest</code
            ></pre>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Limitations</h2>
        <ul class="text">
          {limits.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Similar software</h2>
        <p class="text muted">These overlap with Eirin and may suit you better:</p>
        <ul class="text">
          <li>
            <a href={catalogueViewer}>Astro Catalogue Viewer</a> also catalogues your images
            automatically, with a layout reminiscent of a birdwatching journal. It doesn't help with
            processing, but it's great for looking back at finished images.
          </li>
          <li>
            <a href={sslm}>SSLM</a> is Windows only and focused entirely on the Seestar.
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p>
        Eirin is an independent project and is not affiliated with, endorsed by or connected to ZWO,
        the Siril project or any other tool or device named here. Their names are used only to say
        what Eirin works with.
      </p>
      <p>
        MIT (<a href={`${repo}/blob/main/LICENSE`}>license</a>) · <a href={repo}>GitHub</a> ·
        <a href={`${repo}/issues`}>Report a problem</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  .hero {
    padding: 2.5rem 0 1rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .sub {
    max-width: 38rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0.6rem;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .btn:hover {
    filter: brightness(1.08);
  }

  .fine {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .steps li {
    margin-bottom: 0.75rem;
  }

  details {
    margin-top: 0.5rem;
  }

  summary {
    cursor: pointer;
    color: var(--accent);
  }

  details p {
    margin: 0.75rem 0 0.5rem;
  }

  details pre {
    margin: 0;
  }

  .showcase p {
    max-width: 42rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  #install h3:first-child {
    margin-top: 0;
  }

  footer {
    padding: 2rem 0 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  footer p {
    max-width: 42rem;
    margin: 0 0 0.5rem;
  }
</style>
