---
import type { ImageMetadata } from "astro";
import Screenshot from "./Screenshot.astro";
import VideoShot from "./VideoShot.astro";

interface Props {
  id: string;
  title: string;
  /** Omit for a text-only entry (e.g. when the screenshot is already shown elsewhere). */
  image?: ImageMetadata;
  alt?: string;
  /** Video URL that replaces the image once scrolled into view; `image` becomes its poster. */
  video?: string;
  caption?: string;
  /** Put the screenshot on the left on wide screens. */
  flip?: boolean;
}

const { id, title, image, alt = "", video, caption, flip = false } = Astro.props;
---

<article class:list={["feature", { flip, "text-only": !image }]} id={id}>
  <div class="text">
    <h3>{title}</h3>
    <slot />
  </div>
  {image &&
    (video ? (
      <VideoShot poster={image} video={video} alt={alt} caption={caption} />
    ) : (
      <Screenshot src={image} alt={alt} caption={caption} />
    ))}
</article>

<style>
  .feature {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 2.5rem 0;
  }

  .feature + .feature {
    border-top: 1px dashed var(--border);
  }

  .text :global(p:last-child),
  .text :global(ul:last-child) {
    margin-bottom: 0;
  }

  .text :global(ul) {
    padding-left: 1.2rem;
    color: var(--text-secondary);
  }

  .text :global(li + li) {
    margin-top: 0.35rem;
  }

  .text-only .text {
    max-width: var(--prose);
  }

  @media (min-width: 56rem) {
    .feature:not(.text-only) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
    }

    .feature.flip .text {
      order: 2;
    }
  }
</style>
